<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RoleShuffle</AssemblyName>
    <RootNamespace>REPOJP.StageRoles</RootNamespace>
    <Authors>Codex</Authors>
    <Version>4.4.6</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <CopyFilesToPluginOutputDirectoryOnBuild>false</CopyFilesToPluginOutputDirectoryOnBuild>
    <CopyFilesToPluginOutputDirectoryOnRun>false</CopyFilesToPluginOutputDirectoryOnRun>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="*-*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MenuLib">
      <HintPath>lib\MenuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="StageRolesPlugin.cs" />
    <Compile Include="StageRolesConfig.cs" />
    <Compile Include="RoleUpgradeScaling.cs" />
    <Compile Include="RoleConfigMigration.cs" />
    <Compile Include="RoleModels.cs" />
    <Compile Include="AbilityExhaustionState.cs" />
    <Compile Include="RoleAssignmentPlanner.cs" />
    <Compile Include="RoleAssignmentSync.cs" />
    <Compile Include="RoleGuideCatalog.cs" />
    <Compile Include="RoleGuideSync.cs" />
    <Compile Include="BaseUpgradeSync.cs" />
    <Compile Include="RoleGuideFont.cs" />
    <Compile Include="RoleHud.cs" />
    <Compile Include="RoleHudEditor.cs" />
    <Compile Include="PlayerUtilitiesCore.cs" />
    <Compile Include="PlayerUtilitiesRuntime.cs" />
    <Compile Include="RoleMenu.cs" />
    <Compile Include="RoleEmblems.cs" />
    <Compile Include="RoleTestCommandService.cs" />
    <Compile Include="PlayerState.cs" />
    <Compile Include="PlayerIdentity.cs" />
    <Compile Include="RoleShuffleCompatibilityApi.cs" />
    <Compile Include="EliteEnemyVariantsCompatibility.cs" />
    <Compile Include="CompatibilityApiContract.cs" />
    <Compile Include="StageFluxCompatibility.cs" />
    <Compile Include="VanillaRolePrefabResolver.cs" />
    <Compile Include="UpgradeService.cs" />
    <Compile Include="BaseUpgradeDrawRuntime.cs" />
    <Compile Include="TruckDrawWeight.cs" />
    <Compile Include="BomberRoleRuntime.cs" />
    <Compile Include="MedicRoleRuntime.cs" />
    <Compile Include="RoleHealingRuntime.cs" />
    <Compile Include="MageRoleRuntime.cs" />
    <Compile Include="MageStaffRuntime.cs" />
    <Compile Include="GamblerRoleRuntime.cs" />
    <Compile Include="HunterBatteryRuntime.cs" />
    <Compile Include="StinkerRoleRuntime.cs" />
    <Compile Include="TricksterRoleRuntime.cs" />
    <Compile Include="UtilityRoleRuntime.cs" />
    <Compile Include="MechanicRepairBudget.cs" />
    <Compile Include="EventRoleRuntime.cs" />
    <Compile Include="PendingDamageBudget.cs" />
    <Compile Include="DiverRoleRuntime.cs" />
    <Compile Include="RoleNotifier.cs" />
    <Compile Include="NotificationEnemyReactionGuard.cs" />
    <Compile Include="NotificationEnemyReactionPatches.cs" />
    <Compile Include="StageRoleController.cs" />
    <Compile Include="LifecyclePatches.cs" />
    <Compile Include="ShopPatches.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\role-emblems-semibot-v1\transparent\runtime\*.png"
                      LogicalName="REPOJP.StageRoles.Emblems.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\CheckpointRevenge.bundle"
                      LogicalName="REPOJP.StageRoles.Assets.Fonts.CheckpointRevenge" />
  </ItemGroup>

</Project>
