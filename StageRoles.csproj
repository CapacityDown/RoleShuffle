<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RoleShuffle</AssemblyName>
    <RootNamespace>REPOJP.StageRoles</RootNamespace>
    <Authors>Codex</Authors>
    <Version>5.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <CopyFilesToPluginOutputDirectoryOnBuild>false</CopyFilesToPluginOutputDirectoryOnBuild>
    <CopyFilesToPluginOutputDirectoryOnRun>false</CopyFilesToPluginOutputDirectoryOnRun>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Compile against the installed 0.5.0/Unity 6 assemblies, never old publicized stubs. -->
  <Import Project="Directory.Repo.props" Condition="Exists('Directory.Repo.props')" />
  <PropertyGroup>
    <RepoManagedDirectory Condition="'$(RepoManagedDirectory)' == '' and '$(REPO_GAME_DIR)' != ''">$(REPO_GAME_DIR)/REPO_Data/Managed</RepoManagedDirectory>
  </PropertyGroup>
  <Target Name="RequireInstalledRepo" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RepoManagedDirectory)/Assembly-CSharp.dll')" Text="Set REPO_GAME_DIR to the R.E.P.O. v0.5.0 installation, or RepoManagedDirectory to its REPO_Data/Managed directory." />
  </Target>
  <ItemGroup>
    <Reference Include="$(RepoManagedDirectory)/Assembly-CSharp.dll;$(RepoManagedDirectory)/Assembly-CSharp-firstpass.dll;$(RepoManagedDirectory)/UnityEngine*.dll;$(RepoManagedDirectory)/Unity.TextMeshPro.dll;$(RepoManagedDirectory)/Unity.Localization.dll;$(RepoManagedDirectory)/Unity.InputSystem.dll;$(RepoManagedDirectory)/Photon*.dll;$(RepoManagedDirectory)/Facepunch.Steamworks.Win64.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
