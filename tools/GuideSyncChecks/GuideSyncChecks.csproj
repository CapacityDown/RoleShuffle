  <ItemGroup>
    <Compile Include="../LocalizationChecks/Stubs.cs" Link="CatalogStubs.cs" />
    <Compile Include="../../RoleGuideSync.cs" Link="RoleGuideSync.cs" />
    <Compile Include="../../RoleGuideWire.cs" Link="RoleGuideWire.cs" />
    <Compile Include="../../RoleGuideCatalog.cs" Link="RoleGuideCatalog.cs" />
    <Compile Include="../../RoleOverhaulDescriptions.cs" Link="RoleOverhaulDescriptions.cs" />
    <Compile Include="../../RoleOverhaulRules.cs" Link="RoleOverhaulRules.cs" />
    <Compile Include="../../RoleLanguage.cs" Link="RoleLanguage.cs" />
    <Compile Include="../../RoleText.cs" Link="RoleText.cs" />
    <EmbeddedResource Include="../../Assets/Localization/*.json" LogicalName="REPOJP.StageRoles.Localization.%(Filename)%(Extension)" />
    <Reference Include="Photon3Unity3D"><HintPath>$(GameManagedDir)/Photon3Unity3D.dll</HintPath></Reference>
  </ItemGroup>
</Project>
